# ── Optional AI endpoints ──────────────────────────────────────────────────────
# If left blank, the app uses deterministic fallbacks for all AI features.
# Both variables must be publicly accessible URLs that accept POST requests
# with JSON bodies and return JSON.

# Study-plan generation endpoint
# Expected request body: { accuracy, recentSessions, topicStats }
# Expected response:     { summary, focusAreas, nextSteps, reinforcement }
VITE_AI_STUDY_ENDPOINT=

# Question-variant generation endpoint
# Expected request body: { prompt, explanation, correctAnswer, context }
# Expected response:     { variantPrompt, explanation, correctAnswer }
VITE_AI_VARIANT_ENDPOINT=
